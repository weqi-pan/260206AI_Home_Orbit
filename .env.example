# ==========================================================
# 复制为 .env 后按需修改；docker-compose 与后端均读取该文件
# ==========================================================

# ---- 通义千问（必填，缺失时后端启动即报错）----
DASHSCOPE_API_KEY=sk-your-api-key

# ---- MySQL（docker-compose 使用）----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me

# ---- 数据库（本地无 MySQL 时可不设，后端自动降级 SQLite）----
DATABASE_URL=mysql+pymysql://customer_service:change-me@localhost:3306/customer_service
SQLITE_FALLBACK_URL=sqlite:///backend/data/customer_service.db

# ---- 认证与种子账号 ----
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=Admin@123
DEMO_INITIAL_PASSWORD=Demo@1234

# ---- CORS（逗号分隔；本地开发 5173，docker 访问 80）----
CORS_ORIGINS=http://localhost:5173,http://localhost
