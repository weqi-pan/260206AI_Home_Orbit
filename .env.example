# ==========================================================
# 复制为 .env 后按需修改；docker-compose 与后端均读取该文件
# ==========================================================

# ---- 模型凭据主密钥（Base64 编码的 32 个随机字节；API Key 通过管理员向导加密入库）----
LLM_CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-random-bytes

# ---- 聊天追问生成等待秒数（超时降级为空数组，默认 4）----
# FOLLOWUP_TIMEOUT_SECONDS=4

# ---- MySQL（docker-compose 使用）----
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_PASSWORD=replace-with-a-long-random-password

# ---- 运行模式与数据库（production 强制 MySQL；preview/test 才允许显式 SQLite）----
APP_MODE=production
DATABASE_URL=mysql+pymysql://customer_service:replace-with-a-long-random-password@localhost:3306/customer_service
# 本地单进程预览示例：APP_MODE=preview 且 DATABASE_URL=sqlite:///backend/data/customer_service.db
# 预览/测试模式不启动 Celery；完整部署需要 MySQL + Redis（见 README 部署拓扑）

# ---- 日志（DEBUG / INFO / WARNING / ERROR，默认 INFO）----
# production 输出单行 JSON，preview 输出人类可读格式，test 由 pytest 接管
# LOG_LEVEL=INFO

# ---- Redis / Celery（完整部署；worker 与 beat 由 docker-compose 提供）----
REDIS_URL=redis://localhost:6379/0
# CELERY_RETRY_BACKOFF_SECONDS=30

# ---- 认证与种子账号 ----
JWT_SECRET=replace-with-a-long-random-secret
# ACCESS_TOKEN_MINUTES=60
# REFRESH_TOKEN_DAYS=7
# BCRYPT_ROUNDS=12
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password
DEMO_INITIAL_PASSWORD=replace-with-a-strong-demo-password

# ---- 认证限流（登录只统计失败尝试；注册按每次请求计数。置 0 可单独关掉某一档）----
# AUTH_RATE_LIMIT_ENABLED=true
# 多实例部署用 database（默认，跨进程共享）；单进程可用 memory
# AUTH_RATE_LIMIT_BACKEND=database
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT_USERNAME_ATTEMPTS=10
# LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
# REGISTER_RATE_LIMIT_IP_ATTEMPTS=10
# 只有确实部署在可信反代后面才打开：X-Forwarded-For 可被客户端伪造
# AUTH_RATE_LIMIT_TRUST_FORWARDED_FOR=false

# ---- 数据资产与运行产物路径（一般保持默认）----
# USAGE_CSV_PATH=data/external/records.csv
# KNOWLEDGE_PATH=data
# KNOWLEDGE_UPLOAD_PATH=backend/data/knowledge
# CHROMA_PATH=backend/data/chroma

# ---- CORS（逗号分隔；本地开发 5173，docker 访问 80）----
CORS_ORIGINS=http://localhost:5173,http://localhost
