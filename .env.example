# ==========================================================
# 复制为 .env 后按需修改；docker-compose 与后端均读取该文件
# ==========================================================

# ---- 模型凭据主密钥（Base64 编码的 32 个随机字节；API Key 通过管理员向导加密入库）----
LLM_CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-random-bytes

# ---- 聊天追问生成等待秒数（超时降级为空数组，默认 4）----
# FOLLOWUP_TIMEOUT_SECONDS=4

# ---- MySQL（docker-compose 使用）----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me

# ---- 运行模式与数据库（production 强制 MySQL；preview/test 才允许显式 SQLite）----
APP_MODE=production
DATABASE_URL=mysql+pymysql://customer_service:change-me@localhost:3306/customer_service
# 本地单进程预览示例：APP_MODE=preview 且 DATABASE_URL=sqlite:///backend/data/customer_service.db

# ---- 认证与种子账号 ----
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=Admin@123
DEMO_INITIAL_PASSWORD=Demo@1234

# ---- CORS（逗号分隔；本地开发 5173，docker 访问 80）----
CORS_ORIGINS=http://localhost:5173,http://localhost
